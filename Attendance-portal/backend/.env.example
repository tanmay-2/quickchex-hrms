# ==============================================================================
# QUICKCHEX HRMS — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your production-specific values.
# NEVER commit production .env files containing real secrets to version control.
# NOTE: All existing credentials in source repositories must be rotated before deployment.
# ==============================================================================

# Database Configuration (PostgreSQL is required in production)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
APP_ENV=development
DATABASE_URL=postgresql://postgres:your_postgres_password@127.0.0.1:5432/hrms_db

# Security & JWT Authentication
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & CORS Configuration
# Comma-separated list of allowed origins (e.g. http://SERVER_IP, http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://hrms.example.com
CORS_ALLOW_LAN=true
FRONTEND_URL=http://localhost:5173

# Storage & File Uploads
# Absolute path or relative to application directory where employee documents & payslips persist
UPLOAD_DIR=uploads

# APScheduler Background Service
# Set to true on a SINGLE worker instance to prevent duplicate scheduled jobs
# Enable on exactly one worker/replica to prevent duplicate scheduled actions.
RUN_SCHEDULER=false
SEED_DEMO_DATA=false
RECALCULATE_ATTENDANCE_ON_STARTUP=false

# Development Flags (Production MUST leave this false or unset)
ALLOW_SQLITE_DEV_FALLBACK=false

# SMTP / Email Configuration for Notifications and OTP
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=your_company_email@example.com
EMAIL_PASS=your_email_app_password
SENDER_EMAIL=your_company_email@example.com

# Microsoft SSO / Azure Entra ID
TENANT_ID=your_azure_tenant_id_here
CLIENT_ID=your_azure_client_id_here
CLIENT_SECRET=your_azure_client_secret_here

# Microsoft Graph API / Email Integration
OUTLOOK_TENANT_ID=your_azure_tenant_id_here
OUTLOOK_CLIENT_ID=your_azure_client_id_here
OUTLOOK_CLIENT_SECRET=your_azure_client_secret_here
