# ==============================================================================
# QUICKCHEX HRMS — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before building or running the frontend.
#
# Option A: Direct Server IP Deployment (FastAPI running on port 8000)
# VITE_API_URL=http://YOUR_SERVER_IP:8000
#
# Option B: Nginx Reverse Proxy Deployment (Recommended for Production)
# All requests are served through http://YOUR_SERVER_IP/ and proxied to /api/v1
# VITE_API_URL=/api
#
# Option C: Local Development with Vite (default auto-detects http://localhost:8000)
# VITE_API_URL=http://localhost:8000
# ==============================================================================

VITE_API_URL=http://localhost:8000
# Vite's development proxy target (server-side only; no secrets here).
API_PROXY_TARGET=http://127.0.0.1:8000
VITE_FRONTEND_URL=http://localhost:5173
